{
	"name": "@hexcuit/discord-bot",
	"version": "0.11.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "bun --hot src/index.ts",
		"build": "bun build src/index.ts scripts/deploy-commands.ts --outdir=dist --target=bun",
		"start": "bun dist/src/index.js",
		"check": "bun run lint && bun run format && bun run knip",
		"check:fix": "bun run lint:fix && bun run format:fix && bun run knip:fix",
		"lint": "oxlint --type-aware --type-check",
		"lint:fix": "oxlint --fix --type-aware --type-check",
		"format": "oxfmt --check",
		"format:fix": "oxfmt",
		"knip": "knip",
		"knip:fix": "knip --fix",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"generate:barrels": "bun scripts/generate-barrels.ts --fix",
		"deploy:commands": "bun scripts/deploy-commands.ts",
		"changeset": "changeset",
		"version": "changeset version && bun scripts/fix-canary-deps.ts && bun i --lockfile-only"
	},
	"dependencies": {
		"@hexcuit/server": "0.11.1",
		"discord.js": "14.25.1"
	},
	"devDependencies": {
		"@changesets/changelog-github": "0.5.2",
		"@changesets/cli": "2.29.8",
		"knip": "5.81.0",
		"lefthook": "2.0.15",
		"oxfmt": "0.24.0",
		"oxlint": "1.39.0",
		"oxlint-tsgolint": "0.11.0",
		"typescript": "5.9.3"
	}
}
