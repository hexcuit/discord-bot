	},
	"dependencies": {
		"@hexcuit/server": "1.0.0-canary-20251221061002",
		"@resvg/resvg-js": "2.6.2",
		"discord.js": "14.25.1",
		"satori": "0.18.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@changesets/changelog-github": "0.5.2",
		"@changesets/cli": "2.29.8",
		"@types/bun": "1.3.5",
		"@types/react": "19.2.7",
		"lefthook": "2.0.12",
		"typescript": "5.9.3"
	}
}
