{
	"name": "@hexcuit/discord-bot",
	"version": "0.11.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"scripts": {
		"dev": "bun --hot src/index.ts",
		"build": "bun build src/index.ts scripts/deploy-commands.ts --outdir=dist --target=bun",
		"start": "bun dist/src/index.js",
		"check": "biome check",
		"check:fix": "biome check --fix --unsafe",
		"typecheck": "tsc --noEmit",
		"knip": "knip",
		"knip:fix": "knip --fix",
		"generate:barrels": "bun scripts/generate-barrels.ts --fix",
		"deploy-commands": "bun scripts/deploy-commands.ts",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"changeset": "changeset",
		"version": "changeset version && bun scripts/fix-canary-deps.ts && bun i --lockfile-only"
	},
	"dependencies": {
		"@hexcuit/server": "0.11.1",
		"discord.js": "14.25.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"@changesets/changelog-github": "0.5.2",
		"@changesets/cli": "2.29.8",
		"knip": "5.81.0",
		"lefthook": "2.0.15",
		"typescript": "5.9.3"
	}
}
